(require-builtin steel/hash)
(require-builtin steel/meta)
(require "../lib/lab-client.scm")

(define args (command-line))
(define client (lab-connect (list-ref args 2)))
(define scenario (list-ref args 3))

(define (expect-error message thunk)
  (let ((actual (with-handler error-object-message
                  (thunk)
                  #f)))
    (unless (and (string? actual) (string-contains? actual message)
                 (string-contains? actual "reconnect"))
      (error "Expected a reconnect error containing" message "but got" actual))))

(cond
  ((equal? scenario "interleaved")
   (assert! (equal? (hash-ref (lab-subscribe client 1 "meter/температура") 'status) "ok"))
   (let ((reply (lab-get client 2 "meter/power")))
     (assert! (= (hash-ref reply 'id) 2))
     (assert! (= (hash-ref reply 'value) 99)))
   (let* ((id 18446744073709551615)
          (reply (lab-set client id "meter/power" 7)))
     (assert! (equal? (hash-ref reply 'id) id))
     (assert! (equal? (hash-ref reply 'status) "ok")))
   (for-each (lambda (expected)
               (assert! (= (hash-ref (lab-receive client) 'value) expected)))
             '(11 12 13))
   (let ((measurement (lab-receive client)))
     (assert! (equal? (hash-ref measurement 'event) "measurement"))
     (assert! (equal? (hash-ref measurement 'error) "sensor error")))
   ; All queued frames were returned once. The next frame comes from the socket.
   (assert! (= (hash-ref (lab-receive client) 'value) 15)))
  ((equal? scenario "failure")
   (expect-error (list-ref args 4)
                 (lambda () (lab-set client 9007199254740992 "meter/power" 1)))
   (expect-error "connection is closed"
                 (lambda () (lab-set client 9007199254740993 "meter/power" 1))))
  ((equal? scenario "overflow")
   (expect-error "measurement queue overflow"
                 (lambda () (lab-set client 1 "meter/power" 1)))
   ; The prefix queued before the overflow remains available in order.
   (let drain ((index 0))
     (when (< index 256)
       (assert! (= (hash-ref (lab-receive client) 'value) index))
       (drain (+ index 1))))
   (expect-error "connection is closed" (lambda () (lab-receive client))))
  ((equal? scenario "subscription-error")
   (assert! (equal? (hash-ref (lab-subscribe client 1 "meter/power") 'status) "ok"))
   (expect-error "observation_data_lost" (lambda () (lab-receive client))))
  ((equal? scenario "matched-error")
   (let ((reply (lab-set client 1 "meter/power" 7)))
     (assert! (= (hash-ref reply 'id) 1))
     (assert! (equal? (hash-ref reply 'error) "outcome_unknown")))
   (assert! (= (hash-ref (lab-get client 2 "meter/power") 'value) 99)))
  (else (error "Unknown test scenario" scenario)))

(lab-close client)
(lab-close client)
(displayln "Steel TCP scenario passed")
